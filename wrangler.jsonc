{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feria-carnavalera",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "feria-carnavalera" }],
  "observability": { "enabled": true },
  // Arma la versión para Cloudflare antes de cada "wrangler deploy"
  // (así funciona también con la configuración automática de Cloudflare).
  "build": { "command": "npx opennextjs-cloudflare build" }
}
