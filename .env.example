# ---------- Supabase (Project Settings → API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
# Solo servidor. NUNCA la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------- Sitio ----------
# URL pública (en local: http://localhost:3000). Mercado Pago la usa para volver y para el webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Mercado Pago (Tus integraciones → Credenciales) ----------
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Webhooks → eventos: Pagos, Planes y suscripciones, Pagos recurrentes → "Clave secreta"
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
# Cuota mensual
MP_MONTHLY_PRICE=5000
MP_CURRENCY=ARS

# ---------- Marca (piezas de Higgsfield en /public/brand) ----------
# Si existe, reemplaza al título provisorio del hero/encabezado.
NEXT_PUBLIC_BRAND_WORDMARK=
